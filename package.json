{
  "name": "beeing-human-web",
  "version": "0.19.13",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "npm run clean && vite build",
    "preview": "vite preview",
    "test:unit-essential": "npm run test:unit && npm run test:essential",
    "test:essential": "playwright test tests/E2E/essential",
    "test:ui": "playwright test --ui",
    "test:cli": "playwright test",
    "test:single-worker": "playwright test --workers=1",
    "test:unit-ui": "vitest --ui",
    "test:unit": "vitest run",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "gh-pages": "npm run build && npx gh-pages -t -d build",
    "clean": "trash build"
  },
  "devDependencies": {
    "@iconify/svelte": "^3.1.4",
    "@playwright/test": "^1.39.0",
    "@skeletonlabs/skeleton": "^2.10.3",
    "@skeletonlabs/tw-plugin": "^0.4.0",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.5.27",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@testing-library/user-event": "^14.5.1",
    "@vitest/ui": "^2.1.5",
    "autoprefixer": "^10.4.16",
    "cheerio": "^1.0.0-rc.12",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-svelte": "^2.45.1",
    "gh-pages": "^5.0.0",
    "marked": "^12.0.2",
    "mdsvex": "^0.11.0",
    "postcss": "^8.4.31",
    "postcss-load-config": "^4.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.8",
    "rehype-class-names": "^2.0.0",
    "remark-footnotes": "^2.0.0",
    "smplr": "^0.6.1",
    "standardized-audio-context-mock": "^9.6.30",
    "svelte": "^5.2.0",
    "svelte-preprocess": "^6.0.0",
    "tailwind-clip-path": "^1.0.0",
    "tailwindcss": "^3.3.5",
    "trash-cli": "^5.0.0",
    "vite": "^5.4.4",
    "vitest": "^2.1.5"
  },
  "type": "module",
  "dependencies": {
    "@sentry/sveltekit": "^9.6.1",
    "CETEIcean": "^1.8.0",
    "d3": "^7.8.5",
    "dompurify": "^3.2.0",
    "isomorphic-dompurify": "^2.21.0",
    "jsdom": "^22.1.0",
    "lodash": "^4.17.21",
    "midi-player-js": "^2.0.16",
    "parse-md": "^3.0.3",
    "rehype": "^13.0.2",
    "tify": "^0.31.0",
    "uuid": "^9.0.1",
    "verovio": "^3.16.0"
  }
}
